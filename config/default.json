{
  "seed": 42,
  "paths": {
    "data_dir": "data",
    "outputs_dir": "outputs",
    "engine": "build/tourism_engine"
  },
  "city": {
    "seed": 7
  },
  "history": {
    "days": 120,
    "test_days": 20,
    "seed": 11
  },
  "simulation": {
    "travellers": 150,
    "traveller_weight": 15,
    "sensor_coverage": 0.7,
    "sensor_detection": 0.6,
    "travel_noise": 0.08
  },
  "planning": {
    "candidates": 12,
    "restaurants": 3,
    "local_businesses": 3,
    "crowd_threshold": 0.85,
    "hard_capacity": 1.6,
    "csp": {
      "time_limit_ms": 200,
      "node_limit": 30000,
      "value_limit": 6
    },
    "planner": {
      "max_expansions": 20000,
      "window": 3,
      "shift_window": 150
    }
  },
  "strategies": {
    "conventional": {
      "label": "Conventional (satisfaction only)",
      "weights": {"utility": 1.0, "time": 0.02, "money": 0.001, "crowd": 0.0, "wait": 0.0, "co2": 0.0, "transfer": 0.15, "local": 0.0, "planned_load": 0.0, "dist": 0.0},
      "forecast": "none",
      "crowd_aware": false,
      "collective": false,
      "policy": "keep",
      "replan": false,
      "contingency": false
    },
    "min_distance": {
      "label": "Minimum distance only",
      "weights": {"utility": 0.7, "time": 0.0, "money": 0.0, "crowd": 0.0, "wait": 0.0, "co2": 0.0, "transfer": 0.0, "local": 0.0, "planned_load": 0.0, "dist": 1.2},
      "forecast": "none",
      "crowd_aware": false,
      "collective": false,
      "policy": "keep",
      "replan": false,
      "contingency": false
    },
    "env_only": {
      "label": "Environmental impact only",
      "weights": {"utility": 0.7, "time": 0.0, "money": 0.0, "crowd": 0.0, "wait": 0.0, "co2": 10.0, "transfer": 0.0, "local": 0.0, "planned_load": 0.0, "dist": 0.15},
      "forecast": "none",
      "crowd_aware": false,
      "collective": false,
      "policy": "green",
      "replan": false,
      "contingency": false
    },
    "sustainable": {
      "label": "Sustainable, crowd-aware (full system)",
      "weights": {"utility": 1.0, "time": 0.02, "money": 0.001, "crowd": 3.0, "wait": 0.06, "co2": 0.8, "transfer": 0.15, "local": 1.2, "planned_load": 1.0, "dist": 0.0},
      "forecast": "bayes",
      "crowd_aware": true,
      "collective": true,
      "policy": "q_learning",
      "replan": true,
      "contingency": true
    },
    "sustainable_no_m3": {
      "label": "Full system, historical averages instead of Bayesian forecasts",
      "inherits": "sustainable",
      "forecast": "historical"
    },
    "sustainable_no_rl": {
      "label": "Full system, simple rule instead of the learned policy",
      "inherits": "sustainable",
      "policy": "rule"
    },
    "sustainable_no_replan": {
      "label": "Full system without replanning",
      "inherits": "sustainable",
      "replan": false,
      "contingency": false
    }
  },
  "acceptance": {
    "explanation_boost": 0.35
  },
  "rl": {
    "episodes": 400,
    "eval_episodes": 60,
    "travellers_per_episode": 80,
    "alpha": 0.3,
    "gamma": 0.5,
    "epsilon_start": 1.0,
    "epsilon_end": 0.05,
    "linucb_alpha": 0.6,
    "reward": {
      "satisfaction": 1.0,
      "completed": 0.5,
      "wait": 0.05,
      "crowd": 3.0,
      "externality": 2.0,
      "co2": 2.0,
      "cost": 0.002,
      "less_visited": 0.6,
      "local": 1.0,
      "ask": 0.3,
      "rejected": 0.4
    }
  },
  "risk": {
    "samples": 200,
    "threshold": 0.3
  },
  "evaluation": {
    "quick": {
      "travellers": 120,
      "seeds": [1, 2],
      "scenarios": ["S0_normal", "S1_peak_weekend", "S2_sudden_crowd", "S3_public_event", "S4_transport_delay", "S5_capacity_limit", "S6_rain"],
      "systems": ["conventional", "min_distance", "env_only", "sustainable"],
      "willingness": "mixed",
      "willingness_sweep": {"scenario": "S1_peak_weekend", "levels": ["low", "mixed", "high"], "systems": ["conventional", "sustainable"]},
      "ablation": {"scenarios": ["S1_peak_weekend", "S3_public_event"], "systems": ["sustainable_no_m3", "sustainable_no_rl", "sustainable_no_replan"]}
    },
    "full": {
      "travellers": 200,
      "seeds": [1, 2, 3, 4, 5],
      "scenarios": ["S0_normal", "S1_peak_weekend", "S2_sudden_crowd", "S3_public_event", "S4_transport_delay", "S5_capacity_limit", "S6_rain"],
      "systems": ["conventional", "min_distance", "env_only", "sustainable"],
      "willingness": "mixed",
      "willingness_sweep": {"scenario": "S1_peak_weekend", "levels": ["low", "mixed", "high"], "systems": ["conventional", "sustainable"]},
      "ablation": {"scenarios": ["S1_peak_weekend", "S3_public_event"], "systems": ["sustainable_no_m3", "sustainable_no_rl", "sustainable_no_replan"]}
    }
  }
}
